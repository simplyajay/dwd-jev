generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  administrator
  user

  @@map("role")
}

enum Status {
  awaiting_approval
  active
  inactive

  @@map("status")
}

enum EntryType {
  debit
  credit

  @@map("entry_type")
}

enum JournalType {
  crj
  cdj
  gj
  ckdj
  msij

  @@map("journal_type")
}

enum DocumentCode {
  po
  bur
  or
  inv
  ar
  rcd
  ris
  lr

  @@map("document_code")
}

enum AuditAction {
  create
  update
  delete

  @@map("audit_action")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String    @map("first_name")
  middleName      String?   @map("middle_name")
  lastName        String    @map("last_name")
  username        String    @unique
  password        String
  email           String?   @unique
  role            Role      @default(user)
  position        String
  status          Status    @default(awaiting_approval)
  isSystemAccount Boolean   @default(false) @map("is_system_account")
  approvedBy      String?   @map("approved_by") @db.Uuid
  // Nullable while status is awaiting_approval; set on approval.
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  approvedByUser  User?         @relation("UserApprovedBy", fields: [approvedBy], references: [id])
  approvedUsers   User[]        @relation("UserApprovedBy")
  createdJevs     Jev[]         @relation("JevCreatedBy")
  lastUpdatedJevs Jev[]         @relation("JevLastUpdatedBy")
  deletedJevs     Jev[]         @relation("JevDeletedBy")
  jevRevisions    JevRevision[] @relation("JevRevisionUpdatedBy")

  @@map("users")
}

// jev_number/dv_number/ada_number/check_number are unique only among
// non-deleted rows, via raw-SQL partial indexes (add_jev_unique_document_numbers).
model Jev {
  id            String      @id @default(uuid()) @db.Uuid
  journalType   JournalType @map("journal_type")
  jevNumber     String      @map("jev_number")
  jevDate       DateTime    @map("jev_date") @db.Date
  dvNumber      String?     @map("dv_number")
  dvDate        DateTime?   @map("dv_date") @db.Date
  adaNumber     String?     @map("ada_number")
  adaDate       DateTime?   @map("ada_date") @db.Date
  checkNumber   String?     @map("check_number")
  checkDate     DateTime?   @map("check_date") @db.Date
  payeeName     String?     @map("payee_name")
  description   String
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     String      @map("created_by") @db.Uuid
  lastUpdatedAt DateTime    @default(now()) @updatedAt @map("last_updated_at")
  lastUpdatedBy String      @map("last_updated_by") @db.Uuid
  deletedAt     DateTime?   @map("deleted_at")
  deletedBy     String?     @map("deleted_by") @db.Uuid

  createdByUser     User  @relation("JevCreatedBy", fields: [createdBy], references: [id])
  lastUpdatedByUser User  @relation("JevLastUpdatedBy", fields: [lastUpdatedBy], references: [id])
  deletedByUser     User? @relation("JevDeletedBy", fields: [deletedBy], references: [id])

  accountingEntries         AccountingEntry[]
  supportingDocumentEntries SupportingDocumentEntry[]
  revisions                 JevRevision[]

  @@map("journal_entry_voucher")
}

model JevRevision {
  id         String   @id @default(uuid()) @db.Uuid
  jevId      String   @map("jev_id") @db.Uuid
  beforeData Json     @map("before_data")
  afterData  Json     @map("after_data")
  updatedBy  String   @map("updated_by") @db.Uuid
  updatedAt  DateTime @default(now()) @map("updated_at")

  jev           Jev  @relation(fields: [jevId], references: [id], onDelete: Cascade)
  updatedByUser User @relation("JevRevisionUpdatedBy", fields: [updatedBy], references: [id])

  @@map("jev_revisions")
}

model AccountingEntry {
  id          String    @id @default(uuid()) @db.Uuid
  jevId       String    @map("jev_id") @db.Uuid
  sortOrder   Int       @map("sort_order")
  accountCode String    @map("account_code")
  accountName String    @map("account_name")
  entryType   EntryType @map("entry_type")
  amount      BigInt

  jev                     Jev                     @relation(fields: [jevId], references: [id], onDelete: Cascade)
  externalDocumentEntries ExternalDocumentEntry[]

  @@map("accounting_entries")
}

model SupportingDocumentEntry {
  id             String       @id @default(uuid()) @db.Uuid
  jevId          String       @map("jev_id") @db.Uuid
  sortOrder      Int          @map("sort_order")
  documentNumber String       @map("document_number")
  documentCode   DocumentCode @map("document_code")
  documentName   String       @map("document_name")
  documentDate   DateTime     @map("document_date") @db.Date

  jev Jev @relation(fields: [jevId], references: [id], onDelete: Cascade)

  @@map("supporting_document_entries")
}

model ExternalDocumentEntry {
  id                String    @id @default(uuid()) @db.Uuid
  accountingEntryId String    @map("accounting_entry_id") @db.Uuid
  documentNumber    String    @map("document_number")
  documentName      String    @map("document_name")
  entryType         EntryType @map("entry_type")
  amount            BigInt

  accountingEntry AccountingEntry @relation(fields: [accountingEntryId], references: [id], onDelete: Cascade)

  @@map("external_document_entries")
}

// Standalone activity feed -- no relations. documentType is a plain String,
// not an enum, since new document types (trial_balance, journal, general
// ledger) will be added later and a String avoids an enum-alter migration
// each time. documentId has no FK (it's polymorphic: it points at the
// document's own table for create/delete, but at that document's own
// revision table for update -- resolved in app code via (documentType,
// action), never joined at the DB level).
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  documentType String      @map("document_type")
  documentId   String      @map("document_id") @db.Uuid
  action       AuditAction
  description  String
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ChartOfAccounts {
  id          String  @id @default(uuid()) @db.Uuid
  accountCode String  @map("account_code")
  accountName String  @map("account_name")
  /// General Services Office inventory code (typically 3 digits); used by the desktop app to filter accounts for GSO-related entries.
  gso         String?

  @@map("chart_of_accounts")
}
